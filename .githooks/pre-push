#!/bin/sh
set -eu

echo "[pre-push] Checking canonical docs drift..."
pnpm -s docs:check

echo "[pre-push] Checking docs truth..."
pnpm -s docs:truth

echo "[pre-push] Checking docs structure..."
pnpm -s docs:structure

echo "[pre-push] Checking code docs up to date..."
pnpm -s docs:codegen:check

echo "[pre-push] Guard sandbox-only manifests..."
pnpm -s guard:sandbox-only

echo "[pre-push] Running lint..."
pnpm -s lint

echo "[pre-push] Running typecheck..."
pnpm -s typecheck

echo "[pre-push] Running full test suite..."
pnpm -s test

# ENV-057 — le build exige desormais KYCLY_BASE_URL : sans elle, l'application
# leve au lieu d'appeler `https://api.kycly.sn`, un domaine qui ne resout pas.
# Le hook charge `.env.local` s'il existe, comme un poste de developpement ;
# sinon il dit quoi poser, plutot que de laisser une trace de pile Next.
if [ -f .env.local ]; then
  set -a
  . ./.env.local
  set +a
fi

if [ -z "${KYCLY_BASE_URL:-}" ]; then
  echo "[pre-push] KYCLY_BASE_URL absente — le build va echouer (ENV-057)." >&2
  echo "[pre-push] Posez-la dans .env.local (runtime sandbox de partner-node)," >&2
  echo "[pre-push] ou exportez-la le temps du push." >&2
  exit 1
fi

echo "[pre-push] Running build..."
pnpm -s build